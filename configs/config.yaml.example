server:
  http:
    addr: :4399
    timeout: 10s
  grpc:
    addr: 0.0.0.0:9000
database:
  mysql:
    api: "mysql://root:helloload@127.0.0.1:3306/cbc_explorer?writeTimeout=3s&parseTime=true&loc=Local&charset=utf8mb4,utf8"
  postgres:
    api: "host=localhost user=gorm password=gorm dbname=gorm port=9920 sslmode=disable"
redis:
  proto: tcp
  addr: 127.0.0.1:6379
  password:
  read_timeout: 1s
  write_timeout: 1s
  idle: 10
  active: 100
UI:
  enable_substrate: true
  enable_evm: false